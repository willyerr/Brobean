generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Roaster {
  Id        Int      @id @default(autoincrement())
  Name      String
  Location  String?
  CreatedAt DateTime @default(now())
  
  Beans     Bean[]
}

model Bean {
  Id         Int      @id @default(autoincrement())
  RoasterId  Int
  Name       String
  Origin     String?
  RoastLevel String
  CreatedAt  DateTime @default(now())
  
  Roaster    Roaster  @relation(fields: [RoasterId], references: [Id])
  Brews      Brew[]
}

model BrewMethod {
  Id        Int      @id @default(autoincrement())
  Name      String
  CreatedAt DateTime @default(now())
  
  Brews     Brew[]
}

model Brew {
  Id           Int      @id @default(autoincrement())
  BeanId       Int
  BrewMethodId Int
  Dose         Float    
  Yield        Float    
  Rating       Int      
  Notes        String?  @db.Text
  BrewedAt     DateTime 
  CreatedAt    DateTime @default(now())
  
  Bean         Bean       @relation(fields: [BeanId], references: [Id])
  BrewMethod   BrewMethod @relation(fields: [BrewMethodId], references: [Id])
}