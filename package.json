{
  "name": "brobean",
  "version": "1.0.0",
  "private": true,
  "description": "Aplikasi tracker seduhan kopi.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@brobean/api",
    "dev:web": "npm run dev --workspace=@brobean/web",
    "build:web": "npm run build --workspace=@brobean/web",
    "cap:sync": "npm run build:web && cap sync android",
    "cap:open": "cap open android",
    "android:debug": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "test:web": "npm run test --workspace=@brobean/web",
    "test": "npm run test:web"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/willyerr/Brobean.git"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor-community/sqlite": "^8.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "tsx": "^4.23.15"
  },
  "allowScripts": {
    "better-sqlite3@13.1.1": true,
    "esbuild@0.28.2": true
  }
}
